---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="header-inner">
		<div class="logo-section">
			<a href="/" class="logo">
				<span class="logo-icon">⚡</span>
				<span class="logo-text">{SITE_TITLE}</span>
			</a>
		</div>
		<button class="mobile-toggle" id="mobileToggle" aria-label="切換選單">
			<span></span>
			<span></span>
			<span></span>
		</button>
		<nav id="mainNav">
			<div class="nav-links">
				<HeaderLink href="/">首頁</HeaderLink>
				<HeaderLink href="/blog">文章</HeaderLink>
				<HeaderLink href="/projects">專案</HeaderLink>
				<HeaderLink href="/about">關於</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://github.com/wright0418" target="_blank" rel="noopener" title="GitHub">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
				</a>
				<a href="https://www.youtube.com/c/%E5%A5%B6%E7%88%B8%E7%9A%84%E6%95%99%E8%82%B2" target="_blank" rel="noopener" title="YouTube">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path fill="currentColor" d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.55A3.02 3.02 0 0 0 .5 6.19 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.55 9.38.55 9.38.55s7.5 0 9.38-.55a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.81zM9.54 15.57V8.43L15.82 12l-6.28 3.57z"></path></svg>
				</a>
				<a href="mailto:wright0418.wu@gmail.com" title="Email">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path></svg>
				</a>
			</div>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('mobileToggle');
	const nav = document.getElementById('mainNav');
	toggle?.addEventListener('click', () => {
		nav?.classList.toggle('open');
		toggle?.classList.toggle('active');
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(10, 14, 23, 0.95);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--border-color);
	}
	.header-inner {
		max-width: var(--page-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 1.5em;
		height: 40px;
	}
	.logo a {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		color: var(--text-primary);
		font-weight: 700;
		font-size: 1.15em;
	}
	.logo-icon {
		font-size: 1.3em;
		filter: drop-shadow(0 0 6px var(--accent));
	}
	.logo-text {
		background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.5em;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin-left: 1em;
		padding-left: 1em;
		border-left: 1px solid var(--border-color);
	}
	.social-links a {
		color: var(--text-muted);
		transition: color var(--transition-fast), transform var(--transition-fast);
		display: flex;
		align-items: center;
		padding: 0.35em;
		border-radius: 8px;
	}
	.social-links a:hover {
		color: var(--accent);
		transform: translateY(-1px);
		text-decoration: none;
	}
	.mobile-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5em;
	}
	.mobile-toggle span {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--text-secondary);
		border-radius: 2px;
		transition: all var(--transition-fast);
	}
	.mobile-toggle.active span:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}
	.mobile-toggle.active span:nth-child(2) {
		opacity: 0;
	}
	.mobile-toggle.active span:nth-child(3) {
		transform: rotate(-45deg) translate(5px, -5px);
	}

	@media (max-width: 768px) {
		.mobile-toggle { display: flex; }
		nav {
			display: none;
			position: absolute;
			top: 40px;
			left: 0;
			right: 0;
			background: rgba(10, 14, 23, 0.98);
			backdrop-filter: blur(16px);
			border-bottom: 1px solid var(--border-color);
			flex-direction: column;
			padding: 1em 1.5em;
			gap: 0.5em;
		}
		nav.open { display: flex; }
		.nav-links { flex-direction: column; gap: 0; width: 100%; }
		.social-links {
			margin-left: 0;
			padding-left: 0;
			border-left: none;
			padding-top: 1em;
			border-top: 1px solid var(--border-color);
		}
	}
</style>
